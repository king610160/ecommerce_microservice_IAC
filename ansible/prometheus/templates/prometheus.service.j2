[Unit]
Description=Prometheus
Wants=network-online.target
After=network-online.target

[Service]
User={{ prometheus_user }}
Group={{ prometheus_group }}
Type=simple
ExecStart={{ prometheus_base_dir }}/prometheus/prometheus \
  --config.file={{ prometheus_base_dir }}/prometheus/prometheus.yml \
  --storage.tsdb.path={{ prometheus_data_dir }} \
  --web.console.templates={{ prometheus_base_dir }}/consoles \
  --web.console.libraries={{ prometheus_base_dir }}/console_libraries
Restart=on-failure

[Install]
WantedBy=multi-user.target